{
  "stage": "vae",
  "models": {
    "encoder": {
      "name": "SparseStructureEncoder",
      "args": {
        "in_channels": 1,
        "latent_channels": 8,
        "num_res_blocks": 2,
        "num_res_blocks_middle": 2,
        "channels": [
          32,
          128,
          512
        ],
        "use_fp16": false
      }
    },
    "decoder": {
      "name": "SparseStructureDecoder",
      "args": {
        "out_channels": 1,
        "latent_channels": 8,
        "num_res_blocks": 2,
        "num_res_blocks_middle": 2,
        "channels": [
          512,
          128,
          32
        ],
        "use_fp16": false
      }
    }
  },
  "resolution": 64,
  "batch_size": 1,
  "accumulation_steps": 1,
  "max_steps": 100000,
  "lr": 0.0001,
  "weight_decay": 0.0,
  "precision": "bf16",
  "grad_clip": 1.0,
  "ema_decay": 0.9999,
  "save_every": 1000,
  "log_every": 10,
  "seed": 42,
  "num_workers": 0,
  "loss_type": "dice",
  "lambda_kl": 0.001
}
